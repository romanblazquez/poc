    {
      "id": 13,
      "title": "All Spans \u2014 avg duration by span name",
      "description": "Average duration per span name, derived from Tempo TraceQL. Click a Span Name \u2192 open all matching traces in Explore. The RED table (Prometheus spanmetrics) populates once the metrics generator has been running for a few minutes.",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 54
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" } | select(duration, name)",
          "limit": 2000,
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "name": {
                "aggregations": [
                  "count"
                ],
                "operation": "groupby"
              },
              "duration": {
                "aggregations": [
                  "mean",
                  "max",
                  "p95"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Span Name",
              "count": "Count",
              "mean (duration)": "Avg Duration",
              "max (duration)": "Max Duration",
              "p95 (duration)": "P95 Duration"
            },
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [
              {
                "desc": true,
                "displayName": "Count"
              }
            ]
          }
        }
      ],
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "P95 Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 200000000
                    },
                    {
                      "color": "red",
                      "value": 1000000000
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Span Name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open traces for ${__value.text}",
                    "url": "/explore?orgId=1&left={\"datasource\":\"tempo\",\"queries\":[{\"queryType\":\"traceql\",\"query\":\"{ resource.service.name = \\\"$service\\\" && name = \\\"${__value.text}\\\" }\",\"refId\":\"A\",\"limit\":20}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
