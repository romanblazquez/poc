{
  "uid": "fdc3-user-journey",
  "title": "FDC3 Desktop \u2014 User Journey & Frontend Performance",
  "description": "End-to-end user journey. All metrics are derived directly from Tempo TraceQL \u2014 no Prometheus spanmetrics required. Data appears as soon as spans arrive.",
  "tags": [
    "fdc3",
    "user-journey",
    "frontend",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "current": {
          "text": "market-watch",
          "value": "market-watch"
        },
        "options": [
          {
            "selected": true,
            "text": "market-watch",
            "value": "market-watch"
          },
          {
            "selected": false,
            "text": "obs-sample-api",
            "value": "obs-sample-api"
          }
        ],
        "query": "market-watch,obs-sample-api",
        "hide": 0
      },
      {
        "name": "slow_ms",
        "label": "Slow threshold",
        "type": "custom",
        "current": {
          "text": "200ms",
          "value": "200ms"
        },
        "options": [
          {
            "selected": false,
            "text": "50ms",
            "value": "50ms"
          },
          {
            "selected": false,
            "text": "100ms",
            "value": "100ms"
          },
          {
            "selected": true,
            "text": "200ms",
            "value": "200ms"
          },
          {
            "selected": false,
            "text": "500ms",
            "value": "500ms"
          }
        ],
        "query": "50ms,100ms,200ms,500ms",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "UI Interactions",
      "description": "Ribbon clicks + action button clicks in the selected time window.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && name =~ \"ribbon.*|ui[.]action.*\" }",
          "limit": 5000,
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "count"
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^Count$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
