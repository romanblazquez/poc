    {
      "id": 3,
      "title": "Error Spans",
      "description": "Spans with status ERROR in the selected service.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && status = error }",
          "limit": 1000,
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "count"
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^Count$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Slowest Span (p95)",
      "description": "95th-percentile duration across all spans for the selected service.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "metrics",
          "query": "{ resource.service.name = \"$service\" } | quantile_over_time(duration, 0.95)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 150000000
              },
              {
                "color": "red",
                "value": 500000000
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "User Interaction Rate \u2014 by Event Type",
      "description": "Rate of every tracked UI event stacked by type: ribbon clicks, action buttons, FDC3 broadcasts. Click any legend entry to open matching traces in Tempo Explore.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "metrics",
          "query": "{ resource.service.name = \"$service\" && name =~ \"ribbon.*|ui[.]action.*|fdc3[.]broadcast.*\" } | rate() by (name)",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "sum"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "Open Tempo traces \u2192 ${__series.name}",
              "url": "/explore?orgId=1&left={\"datasource\":\"tempo\",\"queries\":[{\"queryType\":\"traceql\",\"query\":\"{ resource.service.name = \\\"$service\\\" && name = \\\"${__series.name}\\\" }\",\"refId\":\"A\",\"limit\":25}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}",
              "targetBlank": true
            }
          ]
        }
      }
    },
