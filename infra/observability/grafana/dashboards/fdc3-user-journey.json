    {
      "id": 20,
      "title": "Mouse Click Heatmap \u2014 screen cell activity",
      "description": "Each row is a screen region (3\u00d73 grid: top/mid/bottom \u00d7 left/center/right). Colour intensity = click rate. Enable the \ud83d\udd25 Heatmap toggle in market-watch, then click around.",
      "type": "heatmap",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "metrics",
          "query": "{ name = \"ui.mouse.click\" } | rate() by (span.screen.cell)",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "exponent": 0.5,
          "steps": 128,
