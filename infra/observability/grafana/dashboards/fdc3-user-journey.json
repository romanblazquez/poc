          "query": "{ resource.service.name = \"$service\" && name =~ \"fdc3[.]raiseIntent.*\" }",
          "limit": 5000,
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "count"
            ]
          }
        }
      ],
      "options": {
