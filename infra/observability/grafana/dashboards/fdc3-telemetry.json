{
  "uid": "fdc3-telemetry",
  "title": "FDC3 Desktop Telemetry",
  "tags": ["fdc3", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "description": "Spans/sec for every HTTP span across all services. Uses Tempo TraceQL metrics — no Prometheus required.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "metrics",
          "query": "{ name =~ \"HTTP .*\" } | rate() by (resource.service.name, name)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "id": 2,
      "title": "HTTP P95 Latency",
      "description": "95th-percentile duration for HTTP spans. Duration is in nanoseconds from Tempo.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "metrics",
          "query": "{ name =~ \"HTTP .*\" } | quantile_over_time(duration, 0.50, 0.95) by (resource.service.name)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 3,
      "title": "Frontend Route Changes",
      "description": "Angular Router navigation spans emitted by RouterTracerService in ngx-telemetry.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "metrics",
          "query": "{ name =~ \"navigation .*\" } | rate() by (resource.service.name)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 4,
      "title": "FDC3 Intent Rate (by intent)",
      "description": "Rate of fdc3.raiseIntent spans, broken out by intent name.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "metrics",
          "query": "{ name =~ \"fdc3[.]raiseIntent.*\" } | rate() by (name)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "sum"] }
      }
    },
    {
      "id": 5,
      "title": "Trace Search — All Services",
      "description": "Click any row to open the full trace waterfall. Filter: duration > 100ms.",
      "type": "traces",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ duration >= 1ms }",
          "limit": 20,
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableNodeGraph": true,
        "sortBy": [{ "displayName": "Duration", "desc": true }]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
