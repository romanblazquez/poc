{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@fdc3-poc/fdc3-core": ["libs/fdc3-core/src/index.ts"],
      "@fdc3-poc/app-registry": ["libs/app-registry/src/index.ts"],
      "@fdc3-poc/channel-engine": ["libs/channel-engine/src/index.ts"],
      "@fdc3-poc/intent-engine": ["libs/intent-engine/src/index.ts"],
      "@fdc3-poc/workspace-engine": ["libs/workspace-engine/src/index.ts"],
      "@fdc3-poc/interop-electron-adapter": ["libs/interop-electron-adapter/src/index.ts"],
      "@fdc3-poc/interop-browser-adapter": ["libs/interop-browser-adapter/src/index.ts"],
      "@fdc3-poc/interop-ioconnect-adapter": ["libs/interop-ioconnect-adapter/src/index.ts"],
      "@fdc3-poc/shared-domain": ["libs/shared-domain/src/index.ts"],
      "@fdc3-poc/shared-ui": ["libs/shared-ui/src/index.ts"],
      "@/*": ["apps/desktop-shell/src/renderer/*"],
      "@fdc3-poc/interop-angular": ["libs/interop-angular/src/index.ts"],
      "@fdc3-poc/interop-angular/theme": ["libs/interop-angular/theme/src/public-api.ts"],
      "@fdc3-poc/interop-angular/logs": ["libs/interop-angular/logs/src/public-api.ts"],
      "@fdc3-poc/interop-angular/ui": ["libs/interop-angular/ui/src/public-api.ts"],
      "@fdc3-poc/interop-angular/trader": ["libs/interop-angular/trader/src/public-api.ts"]
    }
  },
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/out", "**/.nx"]
}
