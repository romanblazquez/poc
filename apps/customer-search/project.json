{
  "name": "customer-search",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/customer-search/src",
  "targets": {
    "serve": {
      "executor": "@nx/angular:dev-server",
      "options": {
        "buildTarget": "customer-search:build",
        "port": 4001,
        "open": false
      }
    },
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "outputPath": "apps/customer-search/dist",
        "index": "apps/customer-search/src/index.html",
        "browser": "apps/customer-search/src/main.ts",
        "tsConfig": "apps/customer-search/tsconfig.app.json",
        "styles": ["apps/customer-search/src/styles.scss"],
        "assets": []
      }
    }
  }
}
