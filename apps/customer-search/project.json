{
  "name": "customer-search",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/customer-search/src",
  "projectType": "application",
  "tags": ["type:app", "scope:renderer"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --config apps/customer-search/vite.config.ts", "cwd": "{workspaceRoot}" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "vite build --config apps/customer-search/vite.config.ts", "cwd": "{workspaceRoot}" }
    }
  }
}
