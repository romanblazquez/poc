{
  "name": "market-watch",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/market-watch/src",
  "projectType": "application",
  "tags": ["type:app", "scope:renderer"],
  "targets": {
    "serve": { "executor": "nx:run-commands", "options": { "command": "vite --config apps/market-watch/vite.config.ts", "cwd": "{workspaceRoot}" } },
    "build": { "executor": "nx:run-commands", "options": { "command": "vite build --config apps/market-watch/vite.config.ts", "cwd": "{workspaceRoot}" } }
  }
}
