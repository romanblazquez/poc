{
  "name": "rfq-quote",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/rfq-quote/src",
  "targets": {
    "serve": {
      "executor": "@nx/angular:dev-server",
      "options": {
        "buildTarget": "rfq-quote:build",
        "port": 4010,
        "open": false
      }
    },
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "outputPath": "apps/rfq-quote/dist",
        "index": "apps/rfq-quote/src/index.html",
        "browser": "apps/rfq-quote/src/main.ts",
        "tsConfig": "apps/rfq-quote/tsconfig.app.json",
        "styles": ["apps/rfq-quote/src/styles.scss"],
        "assets": []
      }
    }
  }
}
