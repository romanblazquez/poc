{
  "name": "fdc3-desktop-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise FDC3-compatible desktop interoperability shell built on Electron",
  "main": "apps/desktop-shell/out/main/index.js",
  "scripts": {
    "dev": "node tools/scripts/dev.mjs",
    "dev:apps": "concurrently -k -n \"SEARCH,PROFILE,PORTFOLIO,MARKET,PAYMENT,TICKET,BLOTTER,CHART,NEWS,RFQ,FUNDS,ORDERS,AUDIT,THEME,CONFORM,CLOUD\" -c \"cyan,magenta,yellow,green,red,bgBlue,bgMagenta,bgGreen,bgYellow,bgRed,blue,white,gray,black,cyan,bgCyan\" \"nx serve customer-search\" \"nx serve customer-profile\" \"nx serve portfolio-view\" \"nx serve market-watch\" \"nx serve payment-action\" \"nx serve order-ticket\" \"nx serve order-blotter\" \"nx serve chart\" \"nx serve news\" \"nx serve rfq-quote\" \"nx serve funds-allocations\" \"nx serve incoming-orders\" \"nx serve audit-log\" \"nx serve theme-toggle\" \"node tools/scripts/serve-static.mjs apps/fdc3-conformance 4015\" \"nx serve cloud-trader\"",
    "dev:shell": "electron-vite dev --config apps/desktop-shell/electron.vite.config.ts",
    "build": "npm run build:apps && npm run build:shell",
    "build:apps": "CI=true NX_NO_CLOUD=true nx run-many -t build -p customer-search,customer-profile,portfolio-view,market-watch,payment-action,order-ticket,order-blotter,chart,news,rfq-quote,funds-allocations,incoming-orders,audit-log,theme-toggle,cloud-trader",
    "build:shell": "electron-vite build --config apps/desktop-shell/electron.vite.config.ts",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.base.json && tsc --noEmit -p apps/desktop-shell/tsconfig.main.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "dist:server": "node tools/scripts/app-directory-server.mjs",
    "dist:list": "node tools/scripts/distribute.mjs list",
    "dist:push": "node tools/scripts/distribute.mjs push",
    "dist:status": "node tools/scripts/distribute.mjs status",
    "dist:ad-sync": "node tools/scripts/distribute.mjs ad sync",
    "dist:build": "node tools/scripts/build-role.mjs",
    "dist:build:dry": "node tools/scripts/build-role.mjs --dry-run"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@xyflow/react": "^12.10.2",
    "ag-grid-angular": "^35.2.1",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview": "^1.13.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.17.0",
    "primeng": "^21.1.6",
    "radix-ui": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular-devkit/core": "^21.2.0",
    "@angular-devkit/schematics": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@nx/angular": "^22.7.0",
    "@schematics/angular": "^21.2.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "ng-packagr": "^21.2.5",
    "nx": "^22.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.0",
    "vite": "^5.4.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.enterprise.fdc3-desktop-poc",
    "productName": "FDC3 Desktop Shell",
    "icon": "config/assets/icons/build/icon.png",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "apps/desktop-shell/out/**/*",
      "apps/fdc3-conformance/**/*",
      "config/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "mac": {
      "icon": "config/assets/icons/build/mac.icns",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
