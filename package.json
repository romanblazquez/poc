{
  "name": "fdc3-desktop-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise FDC3-compatible desktop interoperability shell built on Electron",
  "main": "apps/desktop-shell/out/main/index.js",
  "scripts": {
    "dev": "node tools/scripts/dev.mjs",
    "dev:apps": "concurrently -k -n \"SEARCH,PROFILE,PORTFOLIO,MARKET,PAYMENT,FUNDS,ORDERS,AUDIT,THEME\" -c \"cyan,magenta,yellow,green,red,blue,white,gray,black\" \"nx serve customer-search\" \"nx serve customer-profile\" \"nx serve portfolio-view\" \"nx serve market-watch\" \"nx serve payment-action\" \"nx serve funds-allocations\" \"nx serve incoming-orders\" \"nx serve audit-log\" \"nx serve theme-toggle\"",
    "dev:shell": "electron-vite dev --config apps/desktop-shell/electron.vite.config.ts",
    "build": "npm run build:apps && npm run build:shell",
    "build:apps": "CI=true NX_NO_CLOUD=true nx run-many -t build -p customer-search,customer-profile,portfolio-view,market-watch,payment-action,funds-allocations,incoming-orders,audit-log,theme-toggle",
    "build:shell": "electron-vite build --config apps/desktop-shell/electron.vite.config.ts",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.base.json && tsc --noEmit -p apps/desktop-shell/tsconfig.main.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@xyflow/react": "^12.10.2",
    "ag-grid-angular": "^35.2.1",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "dockview": "^1.13.0",
    "primeng": "^21.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular-devkit/core": "^21.2.0",
    "@angular-devkit/schematics": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@nx/angular": "^22.7.0",
    "@schematics/angular": "^21.2.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "nx": "^22.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.0",
    "vite": "^5.4.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.enterprise.fdc3-desktop-poc",
    "productName": "FDC3 Desktop Shell",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "apps/desktop-shell/out/**/*",
      "config/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
